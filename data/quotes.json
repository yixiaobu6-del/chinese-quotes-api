[
  {
    "id": "q_001",
    "content": "路漫漫其修远兮，吾将上下而求索。",
    "author": "屈原",
    "source": "《离骚》",
    "theme": "励志",
    "emotion": ["坚定", "追求"],
    "tags": ["坚持", "探索"]
  },
  {
    "id": "q_002",
    "content": "天行健，君子以自强不息。",
    "author": "《周易》",
    "source": "《周易·乾卦》",
    "theme": "励志",
    "emotion": ["刚健", "进取"],
    "tags": ["自强", "奋斗"]
  },
  {
    "id": "q_003",
    "content": "地势坤，君子以厚德载物。",
    "author": "《周易》",
    "source": "《周易·坤卦》",
    "theme": "处世",
    "emotion": ["宽厚", "包容"],
    "tags": ["品德", "修养"]
  },
  {
    "id": "q_004",
    "content": "学而不思则罔，思而不学则殆。",
    "author": "孔子",
    "source": "《论语·为政》",
    "theme": "学习",
    "emotion": ["警示", "理性"],
    "tags": ["学习方法"]
  },
  {
    "id": "q_005",
    "content": "温故而知新，可以为师矣。",
    "author": "孔子",
    "source": "《论语·为政》",
    "theme": "学习",
    "emotion": ["智慧", "踏实"],
    "tags": ["温习", "知识积累"]
  },
  {
    "id": "q_006",
    "content": "三人行，必有我师焉。择其善者而从之，其不善者而改之。",
    "author": "孔子",
    "source": "《论语·述而》",
    "theme": "学习",
    "emotion": ["谦逊", "自省"],
    "tags": ["谦虚", "学习态度"]
  },
  {
    "id": "q_007",
    "content": "己所不欲，勿施于人。",
    "author": "孔子",
    "source": "《论语·卫灵公》",
    "theme": "处世",
    "emotion": ["仁爱", "共情"],
    "tags": ["待人接物", "伦理"]
  },
  {
    "id": "q_008",
    "content": "人不知而不愠，不亦君子乎？",
    "author": "孔子",
    "source": "《论语·学而》",
    "theme": "修养",
    "emotion": ["平和", "豁达"],
    "tags": ["君子", "心态"]
  },
  {
    "id": "q_009",
    "content": "知之为知之，不知为不知，是知也。",
    "author": "孔子",
    "source": "《论语·为政》",
    "theme": "学习",
    "emotion": ["诚实", "理性"],
    "tags": ["求知", "诚实"]
  },
  {
    "id": "q_010",
    "content": "生于忧患，死于安乐。",
    "author": "孟子",
    "source": "《孟子·告子下》",
    "theme": "哲学",
    "emotion": ["警醒", "深刻"],
    "tags": ["忧患意识", "人生哲理"]
  },
  {
    "id": "q_011",
    "content": "天将降大任于是人也，必先苦其心志，劳其筋骨。",
    "author": "孟子",
    "source": "《孟子·告子下》",
    "theme": "励志",
    "emotion": ["激励", "坚定"],
    "tags": ["磨难", "成长"]
  },
  {
    "id": "q_012",
    "content": "富贵不能淫，贫贱不能移，威武不能屈，此之谓大丈夫。",
    "author": "孟子",
    "source": "《孟子·滕文公下》",
    "theme": "气节",
    "emotion": ["刚正", "坚定"],
    "tags": ["大丈夫", "气节"]
  },
  {
    "id": "q_013",
    "content": "老吾老以及人之老，幼吾幼以及人之幼。",
    "author": "孟子",
    "source": "《孟子·梁惠王上》",
    "theme": "处世",
    "emotion": ["仁爱", "温暖"],
    "tags": ["推己及人", "仁政"]
  },
  {
    "id": "q_014",
    "content": "千里之行，始于足下。",
    "author": "老子",
    "source": "《老子》第六十四章",
    "theme": "哲学",
    "emotion": ["平和", "坚韧"],
    "tags": ["行动", "积累"]
  },
  {
    "id": "q_015",
    "content": "上善若水。水善利万物而不争。",
    "author": "老子",
    "source": "《老子》第八章",
    "theme": "哲学",
    "emotion": ["宁静", "超然"],
    "tags": ["不争", "道家"]
  },
  {
    "id": "q_016",
    "content": "祸兮福之所倚，福兮祸之所伏。",
    "author": "老子",
    "source": "《老子》第五十八章",
    "theme": "哲学",
    "emotion": ["辩证", "深邃"],
    "tags": ["辩证法", "祸福"]
  },
  {
    "id": "q_017",
    "content": "道可道，非常道；名可名，非常名。",
    "author": "老子",
    "source": "《老子》第一章",
    "theme": "哲学",
    "emotion": ["玄妙", "深邃"],
    "tags": ["道家", "哲学"]
  },
  {
    "id": "q_018",
    "content": "北冥有鱼，其名为鲲。鲲之大，不知其几千里也。化而为鸟，其名为鹏。",
    "author": "庄子",
    "source": "《庄子·逍遥游》",
    "theme": "哲学",
    "emotion": ["自由", "壮阔"],
    "tags": ["想象", "逍遥"]
  },
  {
    "id": "q_019",
    "content": "子非鱼，安知鱼之乐？",
    "author": "庄子",
    "source": "《庄子·秋水》",
    "theme": "哲学",
    "emotion": ["诙谐", "深邃"],
    "tags": ["认知", "辩论"]
  },
  {
    "id": "q_020",
    "content": "人生自古谁无死，留取丹心照汗青。",
    "author": "文天祥",
    "source": "《过零丁洋》",
    "theme": "气节",
    "emotion": ["悲壮", "坚定"],
    "tags": ["爱国", "民族气节"]
  },
  {
    "id": "q_021",
    "content": "先天下之忧而忧，后天下之乐而乐。",
    "author": "范仲淹",
    "source": "《岳阳楼记》",
    "theme": "胸怀",
    "emotion": ["忧国", "崇高"],
    "tags": ["爱国", "为民"]
  },
  {
    "id": "q_022",
    "content": "不以物喜，不以己悲。",
    "author": "范仲淹",
    "source": "《岳阳楼记》",
    "theme": "修养",
    "emotion": ["平和", "豁达"],
    "tags": ["心态", "修养"]
  },
  {
    "id": "q_023",
    "content": "但愿人长久，千里共婵娟。",
    "author": "苏轼",
    "source": "《水调歌头·明月几时有》",
    "theme": "情感",
    "emotion": ["温暖", "思念"],
    "tags": ["中秋", "亲情"]
  },
  {
    "id": "q_024",
    "content": "大江东去，浪淘尽，千古风流人物。",
    "author": "苏轼",
    "source": "《念奴娇·赤壁怀古》",
    "theme": "怀古",
    "emotion": ["豪迈", "苍凉"],
    "tags": ["历史", "感慨"]
  },
  {
    "id": "q_025",
    "content": "不识庐山真面目，只缘身在此山中。",
    "author": "苏轼",
    "source": "《题西林壁》",
    "theme": "哲理",
    "emotion": ["清醒", "洞见"],
    "tags": ["认知", "局限"]
  },
  {
    "id": "q_026",
    "content": "竹杖芒鞋轻胜马，谁怕？一蓑烟雨任平生。",
    "author": "苏轼",
    "source": "《定风波》",
    "theme": "豁达",
    "emotion": ["洒脱", "乐观"],
    "tags": ["人生态度"]
  },
  {
    "id": "q_027",
    "content": "问君能有几多愁？恰似一江春水向东流。",
    "author": "李煜",
    "source": "《虞美人》",
    "theme": "情感",
    "emotion": ["哀愁", "凄美"],
    "tags": ["亡国", "愁绪"]
  },
  {
    "id": "q_028",
    "content": "衣带渐宽终不悔，为伊消得人憔悴。",
    "author": "柳永",
    "source": "《蝶恋花》",
    "theme": "爱情",
    "emotion": ["执着", "深情"],
    "tags": ["相思", "付出"]
  },
  {
    "id": "q_029",
    "content": "众里寻他千百度，蓦然回首，那人却在，灯火阑珊处。",
    "author": "辛弃疾",
    "source": "《青玉案·元夕》",
    "theme": "爱情",
    "emotion": ["惊喜", "感动"],
    "tags": ["寻觅", "缘分"]
  },
  {
    "id": "q_030",
    "content": "醉里挑灯看剑，梦回吹角连营。",
    "author": "辛弃疾",
    "source": "《破阵子》",
    "theme": "爱国",
    "emotion": ["悲壮", "豪迈"],
    "tags": ["壮志", "报国"]
  },
  {
    "id": "q_031",
    "content": "千古江山，英雄无觅孙仲谋处。",
    "author": "辛弃疾",
    "source": "《永遇乐·京口北固亭怀古》",
    "theme": "怀古",
    "emotion": ["苍凉", "感慨"],
    "tags": ["历史", "英雄"]
  },
  {
    "id": "q_032",
    "content": "寻寻觅觅，冷冷清清，凄凄惨惨戚戚。",
    "author": "李清照",
    "source": "《声声慢》",
    "theme": "情感",
    "emotion": ["孤寂", "哀伤"],
    "tags": ["叠词", "愁绪"]
  },
  {
    "id": "q_033",
    "content": "生当作人杰，死亦为鬼雄。",
    "author": "李清照",
    "source": "《夏日绝句》",
    "theme": "气节",
    "emotion": ["豪迈", "悲愤"],
    "tags": ["爱国", "气节"]
  },
  {
    "id": "q_034",
    "content": "落红不是无情物，化作春泥更护花。",
    "author": "龚自珍",
    "source": "《己亥杂诗》",
    "theme": "奉献",
    "emotion": ["温暖", "崇高"],
    "tags": ["奉献", "牺牲"]
  },
  {
    "id": "q_035",
    "content": "我劝天公重抖擞，不拘一格降人才。",
    "author": "龚自珍",
    "source": "《己亥杂诗》",
    "theme": "励志",
    "emotion": ["愤慨", "期待"],
    "tags": ["人才", "改革"]
  },
  {
    "id": "q_036",
    "content": "海内存知己，天涯若比邻。",
    "author": "王勃",
    "source": "《送杜少府之任蜀州》",
    "theme": "友情",
    "emotion": ["温暖", "豁达"],
    "tags": ["离别", "知己"]
  },
  {
    "id": "q_037",
    "content": "落霞与孤鹜齐飞，秋水共长天一色。",
    "author": "王勃",
    "source": "《滕王阁序》",
    "theme": "美景",
    "emotion": ["壮丽", "宁静"],
    "tags": ["写景", "名句"]
  },
  {
    "id": "q_038",
    "content": "前不见古人，后不见来者。念天地之悠悠，独怆然而涕下。",
    "author": "陈子昂",
    "source": "《登幽州台歌》",
    "theme": "怀古",
    "emotion": ["苍凉", "孤独"],
    "tags": ["感慨", "时空"]
  },
  {
    "id": "q_039",
    "content": "长风破浪会有时，直挂云帆济沧海。",
    "author": "李白",
    "source": "《行路难》",
    "theme": "励志",
    "emotion": ["豪迈", "希望"],
    "tags": ["信念", "奋斗"]
  },
  {
    "id": "q_040",
    "content": "天生我材必有用，千金散尽还复来。",
    "author": "李白",
    "source": "《将进酒》",
    "theme": "自信",
    "emotion": ["豪迈", "洒脱"],
    "tags": ["自信", "乐观"]
  },
  {
    "id": "q_041",
    "content": "举头望明月，低头思故乡。",
    "author": "李白",
    "source": "《静夜思》",
    "theme": "思乡",
    "emotion": ["思念", "温馨"],
    "tags": ["乡愁", "月亮"]
  },
  {
    "id": "q_042",
    "content": "飞流直下三千尺，疑是银河落九天。",
    "author": "李白",
    "source": "《望庐山瀑布》",
    "theme": "美景",
    "emotion": ["震撼", "赞叹"],
    "tags": ["山水", "奇观"]
  },
  {
    "id": "q_043",
    "content": "安得广厦千万间，大庇天下寒士俱欢颜。",
    "author": "杜甫",
    "source": "《茅屋为秋风所破歌》",
    "theme": "胸怀",
    "emotion": ["忧民", "崇高"],
    "tags": ["仁爱", "民生"]
  },
  {
    "id": "q_044",
    "content": "会当凌绝顶，一览众山小。",
    "author": "杜甫",
    "source": "《望岳》",
    "theme": "励志",
    "emotion": ["豪迈", "壮志"],
    "tags": ["攀登", "志向"]
  },
  {
    "id": "q_045",
    "content": "国破山河在，城春草木深。",
    "author": "杜甫",
    "source": "《春望》",
    "theme": "爱国",
    "emotion": ["悲愤", "感慨"],
    "tags": ["战乱", "忧国"]
  },
  {
    "id": "q_046",
    "content": "随风潜入夜，润物细无声。",
    "author": "杜甫",
    "source": "《春夜喜雨》",
    "theme": "哲理",
    "emotion": ["宁静", "温和"],
    "tags": ["春雨", "潜移默化"]
  },
  {
    "id": "q_047",
    "content": "春蚕到死丝方尽，蜡炬成灰泪始干。",
    "author": "李商隐",
    "source": "《无题》",
    "theme": "爱情",
    "emotion": ["深情", "执着"],
    "tags": ["奉献", "相思"]
  },
  {
    "id": "q_048",
    "content": "此情可待成追忆，只是当时已惘然。",
    "author": "李商隐",
    "source": "《锦瑟》",
    "theme": "情感",
    "emotion": ["惆怅", "惋惜"],
    "tags": ["回忆", "遗憾"]
  },
  {
    "id": "q_049",
    "content": "相见时难别亦难，东风无力百花残。",
    "author": "李商隐",
    "source": "《无题》",
    "theme": "爱情",
    "emotion": ["哀伤", "深情"],
    "tags": ["离别", "相思"]
  },
  {
    "id": "q_050",
    "content": "欲穷千里目，更上一层楼。",
    "author": "王之涣",
    "source": "《登鹳雀楼》",
    "theme": "励志",
    "emotion": ["进取", "豪迈"],
    "tags": ["登高", "视野"]
  },
  {
    "id": "q_051",
    "content": "独在异乡为异客，每逢佳节倍思亲。",
    "author": "王维",
    "source": "《九月九日忆山东兄弟》",
    "theme": "思乡",
    "emotion": ["思念", "孤寂"],
    "tags": ["重阳", "亲情"]
  },
  {
    "id": "q_052",
    "content": "劝君更尽一杯酒，西出阳关无故人。",
    "author": "王维",
    "source": "《送元二使安西》",
    "theme": "友情",
    "emotion": ["深情", "感慨"],
    "tags": ["送别", "边塞"]
  },
  {
    "id": "q_053",
    "content": "海上生明月，天涯共此时。",
    "author": "张九龄",
    "source": "《望月怀远》",
    "theme": "思乡",
    "emotion": ["温暖", "思念"],
    "tags": ["月亮", "团圆"]
  },
  {
    "id": "q_054",
    "content": "谁言寸草心，报得三春晖。",
    "author": "孟郊",
    "source": "《游子吟》",
    "theme": "亲情",
    "emotion": ["感恩", "温暖"],
    "tags": ["母爱", "孝道"]
  },
  {
    "id": "q_055",
    "content": "日出江花红胜火，春来江水绿如蓝。",
    "author": "白居易",
    "source": "《忆江南》",
    "theme": "美景",
    "emotion": ["欣喜", "赞叹"],
    "tags": ["江南", "春色"]
  },
  {
    "id": "q_056",
    "content": "野火烧不尽，春风吹又生。",
    "author": "白居易",
    "source": "《赋得古原草送别》",
    "theme": "哲理",
    "emotion": ["坚韧", "希望"],
    "tags": ["生命力", "顽强"]
  },
  {
    "id": "q_057",
    "content": "同是天涯沦落人，相逢何必曾相识。",
    "author": "白居易",
    "source": "《琵琶行》",
    "theme": "情感",
    "emotion": ["伤感", "共情"],
    "tags": ["知音", "漂泊"]
  },
  {
    "id": "q_058",
    "content": "停车坐爱枫林晚，霜叶红于二月花。",
    "author": "杜牧",
    "source": "《山行》",
    "theme": "美景",
    "emotion": ["欣赏", "赞叹"],
    "tags": ["秋景", "枫叶"]
  },
  {
    "id": "q_059",
    "content": "商女不知亡国恨，隔江犹唱后庭花。",
    "author": "杜牧",
    "source": "《泊秦淮》",
    "theme": "怀古",
    "emotion": ["悲愤", "讽刺"],
    "tags": ["兴亡", "忧国"]
  },
  {
    "id": "q_060",
    "content": "清明时节雨纷纷，路上行人欲断魂。",
    "author": "杜牧",
    "source": "《清明》",
    "theme": "情感",
    "emotion": ["哀愁", "萧瑟"],
    "tags": ["清明", "时节"]
  },
  {
    "id": "q_061",
    "content": "宝剑锋从磨砺出，梅花香自苦寒来。",
    "author": "佚名",
    "source": "《警世贤文》",
    "theme": "励志",
    "emotion": ["激励", "坚韧"],
    "tags": ["磨练", "成长"]
  },
  {
    "id": "q_062",
    "content": "书山有路勤为径，学海无涯苦作舟。",
    "author": "韩愈",
    "source": "《古今贤文》",
    "theme": "学习",
    "emotion": ["勤勉", "坚定"],
    "tags": ["勤奋", "治学"]
  },
  {
    "id": "q_063",
    "content": "业精于勤，荒于嬉；行成于思，毁于随。",
    "author": "韩愈",
    "source": "《进学解》",
    "theme": "学习",
    "emotion": ["警示", "严谨"],
    "tags": ["勤奋", "治学态度"]
  },
  {
    "id": "q_064",
    "content": "沉舟侧畔千帆过，病树前头万木春。",
    "author": "刘禹锡",
    "source": "《酬乐天扬州初逢席上见赠》",
    "theme": "哲理",
    "emotion": ["豁达", "希望"],
    "tags": ["新陈代谢", "乐观"]
  },
  {
    "id": "q_065",
    "content": "山重水复疑无路，柳暗花明又一村。",
    "author": "陆游",
    "source": "《游山西村》",
    "theme": "哲理",
    "emotion": ["惊喜", "希望"],
    "tags": ["转机", "坚持"]
  },
  {
    "id": "q_066",
    "content": "纸上得来终觉浅，绝知此事要躬行。",
    "author": "陆游",
    "source": "《冬夜读书示子聿》",
    "theme": "学习",
    "emotion": ["务实", "理性"],
    "tags": ["实践", "理论"]
  },
  {
    "id": "q_067",
    "content": "王师北定中原日，家祭无忘告乃翁。",
    "author": "陆游",
    "source": "《示儿》",
    "theme": "爱国",
    "emotion": ["悲壮", "执着"],
    "tags": ["遗愿", "报国"]
  },
  {
    "id": "q_068",
    "content": "莫等闲，白了少年头，空悲切。",
    "author": "岳飞",
    "source": "《满江红》",
    "theme": "励志",
    "emotion": ["激昂", "紧迫"],
    "tags": ["惜时", "报国"]
  },
  {
    "id": "q_069",
    "content": "三十功名尘与土，八千里路云和月。",
    "author": "岳飞",
    "source": "《满江红》",
    "theme": "爱国",
    "emotion": ["悲壮", "豪迈"],
    "tags": ["功名", "征途"]
  },
  {
    "id": "q_070",
    "content": "墙角数枝梅，凌寒独自开。遥知不是雪，为有暗香来。",
    "author": "王安石",
    "source": "《梅花》",
    "theme": "励志",
    "emotion": ["高洁", "孤傲"],
    "tags": ["品格", "坚韧"]
  },
  {
    "id": "q_071",
    "content": "春风又绿江南岸，明月何时照我还。",
    "author": "王安石",
    "source": "《泊船瓜洲》",
    "theme": "思乡",
    "emotion": ["思念", "期盼"],
    "tags": ["乡愁", "春景"]
  },
  {
    "id": "q_072",
    "content": "不畏浮云遮望眼，自缘身在最高层。",
    "author": "王安石",
    "source": "《登飞来峰》",
    "theme": "哲理",
    "emotion": ["自信", "洞见"],
    "tags": ["眼界", "高度"]
  },
  {
    "id": "q_073",
    "content": "月落乌啼霜满天，江枫渔火对愁眠。",
    "author": "张继",
    "source": "《枫桥夜泊》",
    "theme": "情感",
    "emotion": ["孤寂", "苍凉"],
    "tags": ["秋夜", "羁旅"]
  },
  {
    "id": "q_074",
    "content": "秦时明月汉时关，万里长征人未还。",
    "author": "王昌龄",
    "source": "《出塞》",
    "theme": "爱国",
    "emotion": ["苍凉", "悲壮"],
    "tags": ["边塞", "战争"]
  },
  {
    "id": "q_075",
    "content": "黄沙百战穿金甲，不破楼兰终不还。",
    "author": "王昌龄",
    "source": "《从军行》",
    "theme": "爱国",
    "emotion": ["豪迈", "坚定"],
    "tags": ["边塞", "壮志"]
  },
  {
    "id": "q_076",
    "content": "洛阳亲友如相问，一片冰心在玉壶。",
    "author": "王昌龄",
    "source": "《芙蓉楼送辛渐》",
    "theme": "友情",
    "emotion": ["高洁", "真挚"],
    "tags": ["送别", "品格"]
  },
  {
    "id": "q_077",
    "content": "葡萄美酒夜光杯，欲饮琵琶马上催。",
    "author": "王翰",
    "source": "《凉州词》",
    "theme": "边塞",
    "emotion": ["豪迈", "悲壮"],
    "tags": ["边塞", "豪饮"]
  },
  {
    "id": "q_078",
    "content": "旧时王谢堂前燕，飞入寻常百姓家。",
    "author": "刘禹锡",
    "source": "《乌衣巷》",
    "theme": "怀古",
    "emotion": ["沧桑", "感慨"],
    "tags": ["兴衰", "变迁"]
  },
  {
    "id": "q_079",
    "content": "东边日出西边雨，道是无晴却有晴。",
    "author": "刘禹锡",
    "source": "《竹枝词》",
    "theme": "爱情",
    "emotion": ["含蓄", "俏皮"],
    "tags": ["谐音", "双关"]
  },
  {
    "id": "q_080",
    "content": "千淘万漉虽辛苦，吹尽狂沙始到金。",
    "author": "刘禹锡",
    "source": "《浪淘沙》",
    "theme": "励志",
    "emotion": ["坚毅", "希望"],
    "tags": ["坚持", "收获"]
  },
  {
    "id": "q_081",
    "content": "采菊东篱下，悠然见南山。",
    "author": "陶渊明",
    "source": "《饮酒·其五》",
    "theme": "隐逸",
    "emotion": ["宁静", "悠闲"],
    "tags": ["田园", "归隐"]
  },
  {
    "id": "q_082",
    "content": "不戚戚于贫贱，不汲汲于富贵。",
    "author": "陶渊明",
    "source": "《五柳先生传》",
    "theme": "修养",
    "emotion": ["淡泊", "超然"],
    "tags": ["安贫乐道"]
  },
  {
    "id": "q_083",
    "content": "盛年不重来，一日难再晨。及时当勉励，岁月不待人。",
    "author": "陶渊明",
    "source": "《杂诗》",
    "theme": "励志",
    "emotion": ["紧迫", "劝勉"],
    "tags": ["惜时", "努力"]
  },
  {
    "id": "q_084",
    "content": "老骥伏枥，志在千里。烈士暮年，壮心不已。",
    "author": "曹操",
    "source": "《龟虽寿》",
    "theme": "励志",
    "emotion": ["豪迈", "坚定"],
    "tags": ["壮志", "老年"]
  },
  {
    "id": "q_085",
    "content": "对酒当歌，人生几何！譬如朝露，去日苦多。",
    "author": "曹操",
    "source": "《短歌行》",
    "theme": "人生",
    "emotion": ["感慨", "豪迈"],
    "tags": ["惜时", "感慨"]
  },
  {
    "id": "q_086",
    "content": "鞠躬尽瘁，死而后已。",
    "author": "诸葛亮",
    "source": "《后出师表》",
    "theme": "奉献",
    "emotion": ["忠诚", "坚定"],
    "tags": ["奉献", "忠诚"]
  },
  {
    "id": "q_087",
    "content": "非淡泊无以明志，非宁静无以致远。",
    "author": "诸葛亮",
    "source": "《诫子书》",
    "theme": "修养",
    "emotion": ["冷静", "深邃"],
    "tags": ["家教", "修身"]
  },
  {
    "id": "q_088",
    "content": "勿以恶小而为之，勿以善小而不为。",
    "author": "刘备",
    "source": "《三国志·蜀书·先主传》",
    "theme": "修养",
    "emotion": ["警醒", "严肃"],
    "tags": ["品德", "教育"]
  },
  {
    "id": "q_089",
    "content": "知己知彼，百战不殆。",
    "author": "孙子",
    "source": "《孙子兵法·谋攻篇》",
    "theme": "智慧",
    "emotion": ["理性", "睿智"],
    "tags": ["兵法", "策略"]
  },
  {
    "id": "q_090",
    "content": "投之亡地然后存，陷之死地然后生。",
    "author": "孙子",
    "source": "《孙子兵法·九地篇》",
    "theme": "智慧",
    "emotion": ["决绝", "勇气"],
    "tags": ["兵法", "谋略"]
  },
  {
    "id": "q_091",
    "content": "青，取之于蓝，而青于蓝。",
    "author": "荀子",
    "source": "《荀子·劝学》",
    "theme": "学习",
    "emotion": ["启发", "赞赏"],
    "tags": ["超越", "进步"]
  },
  {
    "id": "q_092",
    "content": "锲而不舍，金石可镂；锲而舍之，朽木不折。",
    "author": "荀子",
    "source": "《荀子·劝学》",
    "theme": "学习",
    "emotion": ["坚定", "激励"],
    "tags": ["坚持", "毅力"]
  },
  {
    "id": "q_093",
    "content": "水能载舟，亦能覆舟。",
    "author": "魏徵",
    "source": "《贞观政要》",
    "theme": "政治",
    "emotion": ["警醒", "深刻"],
    "tags": ["民心", "治国"]
  },
  {
    "id": "q_094",
    "content": "以铜为镜，可以正衣冠；以史为镜，可以知兴替；以人为镜，可以明得失。",
    "author": "李世民",
    "source": "《旧唐书·魏徵传》",
    "theme": "智慧",
    "emotion": ["睿智", "深刻"],
    "tags": ["借鉴", "自省"]
  },
  {
    "id": "q_095",
    "content": "塞翁失马，焉知非福。",
    "author": "《淮南子》",
    "source": "《淮南子·人间训》",
    "theme": "哲学",
    "emotion": ["豁达", "平和"],
    "tags": ["祸福", "辩证"]
  },
  {
    "id": "q_096",
    "content": "近朱者赤，近墨者黑。",
    "author": "傅玄",
    "source": "《太子少傅箴》",
    "theme": "处世",
    "emotion": ["警醒", "理性"],
    "tags": ["环境", "交友"]
  },
  {
    "id": "q_097",
    "content": "良药苦口利于病，忠言逆耳利于行。",
    "author": "《增广贤文》",
    "source": "《增广贤文》",
    "theme": "处世",
    "emotion": ["理性", "诚恳"],
    "tags": ["劝诫", "批评"]
  },
  {
    "id": "q_098",
    "content": "一年之计在于春，一日之计在于晨。",
    "author": "《增广贤文》",
    "source": "《增广贤文》",
    "theme": "励志",
    "emotion": ["积极", "紧迫"],
    "tags": ["惜时", "计划"]
  },
  {
    "id": "q_099",
    "content": "有志者，事竟成，破釜沉舟，百二秦关终属楚。",
    "author": "蒲松龄",
    "source": "自勉联",
    "theme": "励志",
    "emotion": ["激昂", "坚定"],
    "tags": ["立志", "奋斗"]
  },
  {
    "id": "q_100",
    "content": "苦心人，天不负，卧薪尝胆，三千越甲可吞吴。",
    "author": "蒲松龄",
    "source": "自勉联",
    "theme": "励志",
    "emotion": ["激昂", "坚定"],
    "tags": ["毅力", "复仇"]
  },
  {
    "id": "q_101",
    "content": "世事洞明皆学问，人情练达即文章。",
    "author": "曹雪芹",
    "source": "《红楼梦》",
    "theme": "处世",
    "emotion": ["睿智", "深刻"],
    "tags": ["阅历", "学问"]
  },
  {
    "id": "q_102",
    "content": "假作真时真亦假，无为有处有还无。",
    "author": "曹雪芹",
    "source": "《红楼梦》",
    "theme": "哲学",
    "emotion": ["玄妙", "深邃"],
    "tags": ["真假", "辩证"]
  },
  {
    "id": "q_103",
    "content": "千磨万击还坚劲，任尔东西南北风。",
    "author": "郑燮",
    "source": "《竹石》",
    "theme": "励志",
    "emotion": ["坚毅", "不屈"],
    "tags": ["品格", "坚韧"]
  },
  {
    "id": "q_104",
    "content": "人生如逆旅，我亦是行人。",
    "author": "苏轼",
    "source": "《临江仙·送钱穆父》",
    "theme": "人生",
    "emotion": ["豁达", "通透"],
    "tags": ["过客", "人生感悟"]
  },
  {
    "id": "q_105",
    "content": "人间有味是清欢。",
    "author": "苏轼",
    "source": "《浣溪沙·细雨斜风作晓寒》",
    "theme": "人生",
    "emotion": ["宁静", "满足"],
    "tags": ["生活", "品味"]
  },
  {
    "id": "q_106",
    "content": "人生到处知何似，应似飞鸿踏雪泥。",
    "author": "苏轼",
    "source": "《和子由渑池怀旧》",
    "theme": "人生",
    "emotion": ["感慨", "通透"],
    "tags": ["人生感悟", "雪泥鸿爪"]
  },
  {
    "id": "q_107",
    "content": "此中有真意，欲辨已忘言。",
    "author": "陶渊明",
    "source": "《饮酒·其五》",
    "theme": "哲学",
    "emotion": ["宁静", "玄妙"],
    "tags": ["禅意", "真趣"]
  },
  {
    "id": "q_108",
    "content": "行到水穷处，坐看云起时。",
    "author": "王维",
    "source": "《终南别业》",
    "theme": "豁达",
    "emotion": ["悠闲", "超然"],
    "tags": ["禅意", "随遇而安"]
  },
  {
    "id": "q_109",
    "content": "大漠孤烟直，长河落日圆。",
    "author": "王维",
    "source": "《使至塞上》",
    "theme": "美景",
    "emotion": ["壮阔", "苍凉"],
    "tags": ["边塞", "写景"]
  },
  {
    "id": "q_110",
    "content": "春花秋月何时了，往事知多少。",
    "author": "李煜",
    "source": "《虞美人》",
    "theme": "情感",
    "emotion": ["哀愁", "感慨"],
    "tags": ["亡国", "回忆"]
  }
]